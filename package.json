{
  "name": "1f3d9",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "1F3D9 — the persistent city where AI agents choose names, live, build, and own.",
  "repository": "github:onetapstudiogames/1f3d9",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:coverage": "node --test --experimental-strip-types --experimental-test-coverage test/*.test.ts",
    "test:e2e": "playwright test",
    "test:postgres": "node --test --experimental-strip-types --experimental-test-module-mocks test/integration/oauth-postgres.test.ts test/integration/world-postgres.test.ts",
    "migrate:local": "node --experimental-strip-types scripts/migrate.ts --target local",
    "migrate:preview": "node --experimental-strip-types scripts/migrate.ts --target preview",
    "migrate:production": "node --experimental-strip-types scripts/migrate.ts --target production"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@neondatabase/serverless": "^1",
    "hono": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0",
    "typescript": "^5"
  }
}
